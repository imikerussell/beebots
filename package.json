{
  "name": "catfolio",
  "version": "2026.10.21",
  "private": true,
  "description": "Two independent cats with upstream Argon strategies and auditable paper trading",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@okx_ai/okx-trade-cli"
    ]
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "universe": "tsx --env-file-if-exists=.env src/tools/universe.ts",
    "snapshot": "tsx --env-file-if-exists=.env src/tools/snapshot.ts",
    "parity": "tsx src/tools/parity-market.ts",
    "keycheck": "tsx --env-file-if-exists=.env src/tools/keycheck.ts",
    "demo:roundtrip": "tsx --env-file-if-exists=.env src/tools/demo-roundtrip.ts",
    "demo:close": "tsx --env-file-if-exists=.env src/tools/demo-close.ts",
    "setup": "tsx --env-file-if-exists=.env src/tools/setup.ts",
    "local:check": "tsx --env-file-if-exists=.env src/tools/local-check.ts",
    "report": "tsx --env-file-if-exists=.env src/tools/report.ts",
    "replay": "tsx --env-file-if-exists=.env src/tools/replay.ts",
    "research:fetch": "tsx src/research/fetch-history.ts",
    "research:funding": "tsx src/research/fetch-funding.ts",
    "research:compare": "tsx src/research/compare.ts",
    "paper:stop": "tsx --env-file-if-exists=.env src/tools/paper-stop.ts",
    "test:integration": "vitest run test/local-integration.test.ts test/engine.test.ts test/jev.test.ts",
    "effective-config": "tsx src/tools/effective-config.ts",
    "provider:check": "tsx --env-file-if-exists=.env src/tools/provider-check.ts"
  },
  "dependencies": {
    "@okx_ai/okx-trade-cli": "1.4.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
