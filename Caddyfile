:8080 {
  encode zstd gzip
  @api {
    path /events /snapshot /history /equity /visit /health /live /profile /report /coach /coach/* /controls/*
  }
  handle @api {
    reverse_proxy engine:8080 {
      flush_interval -1
    }
  }
  handle {
    root * /srv/dashboard
    try_files {path} /index.html
    file_server
  }
  header {
    -Server
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  }
}
