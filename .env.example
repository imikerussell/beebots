# Catfolio: upstream Argon strategies with the existing two-cat dashboard and trainer.
# Gemini uses paid API calls. Missing key/budget/error: CODE can trade by fixed menu priorities.
# Code does not read free-text rules. Paper mode stays enforced in Compose.
DECISION_PROVIDER=gemini
STRATEGY_ENGINE=upstream
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
GEMINI_DAILY_USD_CAP=3
GEMINI_MIN_INTERVAL_MS=60000
GEMINI_TIMEOUT_MS=3000
# Upstream accounting defaults; check Google's current pricing before a paid run.
GEMINI_USD_PER_MTOK=4
GEMINI_USD_PER_MTOK_OUT=20
GEMINI_THINKING_LEVEL=
# Existing strategies remain available: STRATEGY_ENGINE=catfolio.
# Existing providers remain available: DECISION_PROVIDER=lmstudio or jev.
DRY_RUN=true
MODE=paper
TOTAL_START_EQUITY_USD=200
TIGER_ALLOCATION_PCT=50
MOCHI_ALLOCATION_PCT=50
DB_PATH=./data/catfolio-argon-{mode}.sqlite
SETTINGS_PATH=./data/catfolio-settings.json

# One loaded Nimble decision model serves both cats. Use its ACTUAL loaded identifier.
LM_STUDIO_ORIGIN=http://127.0.0.1:1234
LM_STUDIO_MODEL=
LM_STUDIO_TOKEN=
LM_STUDIO_TIMEOUT_MS=45000
LM_STUDIO_CONCURRENCY=1
# Provider limit; strategies offer the top eligible candidate plus WAIT by default.
LM_STUDIO_MAX_OPTIONS=26
# Record exact app build, selected inference engine, and artifact revision/quantization/hash.
LM_STUDIO_VERSION=
LM_STUDIO_ENGINE=
LM_STUDIO_ARTIFACT=

# Optional Jev CLOUD backend. Used ONLY when DECISION_PROVIDER=jev; API calls are billed.
# typesafe = direct API; vercel = Vercel AI Gateway (set JEV_MODEL=typesafe-ai/jev).
JEV_TRANSPORT=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=10000
JEV_CONCURRENCY=1
# Estimated USD budget per UTC day / database; not an account-wide billing hard cap.
JEV_DAILY_USD_CAP=2
# Estimated input-token price. Check your provider pricing; timeout charges may be unreported.
JEV_USD_PER_MTOK=0.042

DECISION_INTERVAL_MS=10000
MAX_TICKER_AGE_MS=15000
DATA_REFRESH_MS=60000

# Effective settings: docs/CONFIGURATION.md. Deployment values override defaults.
# Owner risk limits are never changed by the trainer.
TIGER_NAME="DARK Wall-E"
TIGER_MAX_NOTIONAL_PCT=200
TIGER_DAILY_LOSS_STOP_PCT=8
TIGER_MAX_ENTRIES_PER_DAY=4
TIGER_COOLDOWN_MINUTES=30
TIGER_SPREAD_GATE_BPS=5
TIGER_MIN_24H_VOLUME_USD=1000000
TIGER_FEE_BUDGET_USD_DAY=1.2
TIGER_STOP_RISK_PCT=0.5
TIGER_MIN_ACTION_PROBABILITY=0.55
TIGER_MIN_CONVICTION=1
# Legacy Catfolio signal controls below apply only with STRATEGY_ENGINE=catfolio.
TIGER_MIN_MOMENTUM_PCT=0.1
TIGER_MOMENTUM_ATR_MULT=0.25
TIGER_STOP_ATR_MULT=2
TIGER_MAX_HOLD_MINUTES=120
# Experimental alternatives are available for paper comparison, not validated alpha.
TIGER_SIGNAL_MODE=momentum
# Used by trend_momentum and trend_breakout (hourly regime):
TIGER_TREND_FAST_HOURS=20
TIGER_TREND_SLOW_HOURS=50
# Used by trend_breakout (completed 15-minute candles):
TIGER_BREAKOUT_BARS=20
TIGER_EXIT_BARS=10
TIGER_MIN_STOP_COST_RATIO=3
TIGER_MAX_ENTRY_CHASE_ATR=0.5
TIGER_MAX_ENTRY_CANDIDATES=1
# Profit exits (v9+): thresholds use estimated net profit / initial stop risk.
# Model profit reviews are separate from the 15-minute entry cadence.
TIGER_BREAKEVEN_AT_R=0.5
TIGER_BREAKEVEN_BUFFER_BPS=1
TIGER_TRAIL_ACTIVATION_R=0.75
TIGER_TRAIL_ATR_MULT=1
TIGER_PROFIT_LOCK_AT_R=1
TIGER_MAX_PROFIT_GIVEBACK_PCT=35
TIGER_PARTIAL_TAKE_PROFIT_ENABLED=true
TIGER_PARTIAL_TAKE_PROFIT_AT_R=1.5
TIGER_PARTIAL_TAKE_PROFIT_FRACTION=0.5
TIGER_EXIT_REVIEW_MIN_R=0.5
TIGER_EXIT_REVIEW_INTERVAL_SECONDS=60
TIGER_EXIT_MIN_ACTION_PROBABILITY=0.4

MOCHI_NAME="Good Wall-E"
MOCHI_MAX_NOTIONAL_PCT=200
MOCHI_DAILY_LOSS_STOP_PCT=8
MOCHI_MAX_ENTRIES_PER_DAY=2
MOCHI_COOLDOWN_MINUTES=240
MOCHI_SPREAD_GATE_BPS=5
MOCHI_MIN_24H_VOLUME_USD=1000000
MOCHI_MIN_ACTION_PROBABILITY=0.550
MOCHI_MIN_CONVICTION=1
MOCHI_MIN_TREND_SCORE=4
MOCHI_STOP_RISK_PCT=0.25
MOCHI_VOL_TARGET_PCT=25
MOCHI_TRIM_SCORE_DROP=3
MOCHI_MAX_HOLD_MINUTES=360
MOCHI_STOP_ATR_MULT=2
MOCHI_FEE_BUDGET_USD_DAY=0.75
MOCHI_MIN_STOP_COST_RATIO=3
MOCHI_MAX_ENTRY_CHASE_ATR=0.5
MOCHI_MAX_ENTRY_CANDIDATES=1
# Same exit controls, with slower defaults for the four-hour trend strategy.
MOCHI_BREAKEVEN_AT_R=1
MOCHI_BREAKEVEN_BUFFER_BPS=1
MOCHI_TRAIL_ACTIVATION_R=1.5
MOCHI_TRAIL_ATR_MULT=1.5
MOCHI_PROFIT_LOCK_AT_R=2
MOCHI_MAX_PROFIT_GIVEBACK_PCT=40
MOCHI_PARTIAL_TAKE_PROFIT_ENABLED=true
MOCHI_PARTIAL_TAKE_PROFIT_AT_R=2
MOCHI_PARTIAL_TAKE_PROFIT_FRACTION=0.5
MOCHI_EXIT_REVIEW_MIN_R=1
MOCHI_EXIT_REVIEW_INTERVAL_SECONDS=300
MOCHI_EXIT_MIN_ACTION_PROBABILITY=0.4
MAX_NOTIONAL_USD_PER_BEE=700

# Fill at bid/ask plus this adverse slippage; fees on every fill.
PAPER_SLIPPAGE_BPS=2
TAKER_FEE_RATE=0.0005
MAX_LEVERAGE=2
OKX_API_BASE=https://eea.okx.com
OKX_CLI_TIMEOUT_MS=10000
ENGINE_BIND=127.0.0.1
ENGINE_PORT=8080
LOG_LEVEL=info

# Docker host override (used only by Compose):
LM_STUDIO_HOST_ORIGIN=http://host.docker.internal:1234
DASHBOARD_PORT=8088
# A new filename starts a new run; preserve old files when changing starting capital.
DOCKER_DB_PATH=/data/catfolio-paper.sqlite

# Demo/live plumbing retained; keep DRY_RUN=true for this experiment.
# MODE=demo additionally requires DRY_RUN=false and TWO distinct demo sub-accounts:
# TIGER_OKX_DEMO_API_KEY=...
# TIGER_OKX_DEMO_API_SECRET=...
# TIGER_OKX_DEMO_API_PASSPHRASE=...
# MOCHI_OKX_DEMO_API_KEY=...
# MOCHI_OKX_DEMO_API_SECRET=...
# MOCHI_OKX_DEMO_API_PASSPHRASE=...
# Live also requires the original exact LIVE_ACK phrase, plus TIGER_OKX_API_*
# and MOCHI_OKX_API_* credentials. No live credentials/ack are supplied here.
# LIVE_SIZE_MULTIPLIER=0.25
# LIVE_RAMP_HOURS=2

# Scheduled strategy reviews run at most once per cat per 4 hours, using the Vercel AI Gateway text model.
# Benched with STRATEGY_ENGINE=upstream, even if a gateway key or old enable flags exist.
# With STRATEGY_ENGINE=catfolio, defaults to enabled when AI_GATEWAY_API_KEY is present.
# COACH_ENABLED=true
# Suggestions only by default. True permits bounded changes after evidence checks.
COACH_AUTO_APPLY=false
COACH_MODEL=anthropic/claude-sonnet-4.6
# Optional owner-only recovery key (at least 24 characters). Never use your Vercel key.
# Generate with: openssl rand -hex 32
# Protects strategy recovery and the dashboard's entry-limit reset; automatic reviews do not need this key.
COACH_ADMIN_TOKEN=
