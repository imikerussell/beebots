# Catfolio: overnight PAPER experiment. No exchange keys; local AI is the default.
# Explicit choice only: lmstudio or jev. Restart the engine after changing this.
DECISION_PROVIDER=lmstudio
DRY_RUN=true
MODE=paper
TOTAL_START_EQUITY_USD=200
TIGER_ALLOCATION_PCT=50
MOCHI_ALLOCATION_PCT=50
DB_PATH=./data/catfolio-{mode}.sqlite
SETTINGS_PATH=./data/catfolio-settings.json

# One loaded Nimble decision model serves both cats. Use its ACTUAL loaded identifier.
LM_STUDIO_ORIGIN=http://127.0.0.1:1234
LM_STUDIO_MODEL=
LM_STUDIO_TOKEN=
LM_STUDIO_TIMEOUT_MS=45000
LM_STUDIO_CONCURRENCY=1
# Conservative limit; current Catfolio menus use at most 7 choices; never truncated.
LM_STUDIO_MAX_OPTIONS=26
# Record exact app build, selected inference engine, and artifact revision/quantization/hash.
LM_STUDIO_VERSION=
LM_STUDIO_ENGINE=
LM_STUDIO_ARTIFACT=

# Optional Jev CLOUD backend. Used ONLY when DECISION_PROVIDER=jev; API calls are billed.
# typesafe = direct API; vercel = Vercel AI Gateway (set JEV_MODEL=typesafe-ai/jev).
JEV_TRANSPORT=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=10000
JEV_CONCURRENCY=1
# Estimated USD budget per UTC day / database; not an account-wide billing hard cap.
JEV_DAILY_USD_CAP=2
# Estimated input-token price. Check your provider pricing; timeout charges may be unreported.
JEV_USD_PER_MTOK=0.042

DECISION_INTERVAL_MS=60000
PROTECTIVE_INTERVAL_MS=5000
MAX_DECISION_AGE_MS=55000
MAX_TICKER_AGE_MS=15000
DATA_REFRESH_MS=60000

# Upstream source defaults. Existing deployment overrides take precedence.
TIGER_NAME="DARK Wall-E"
TIGER_MAX_NOTIONAL_PCT=200
TIGER_DAILY_LOSS_STOP_PCT=8
TIGER_MAX_ENTRIES_PER_DAY=1
TIGER_COOLDOWN_MINUTES=5
TIGER_SPREAD_GATE_BPS=5
TIGER_MIN_24H_VOLUME_USD=1000000
TIGER_FEE_BUDGET_USD_DAY=1

MOCHI_NAME="Good Wall-E"
MOCHI_MAX_NOTIONAL_PCT=200
MOCHI_DAILY_LOSS_STOP_PCT=8
MOCHI_MAX_ENTRIES_PER_DAY=3
MOCHI_COOLDOWN_MINUTES=240
MOCHI_SPREAD_GATE_BPS=5
MOCHI_MIN_24H_VOLUME_USD=1000000
MOCHI_MIN_ACTION_PROBABILITY=0.70
MOCHI_STOP_ATR_MULT=2
MOCHI_MAX_FLAT_MINUTES=0
MOCHI_FEE_BUDGET_USD_DAY=1
BREEZY_MIN_SIZE_USD=10
MAX_NOTIONAL_USD_PER_BEE=700

# Fill at bid/ask plus this adverse slippage; fees on every fill.
PAPER_SLIPPAGE_BPS=2
TAKER_FEE_RATE=0.0005
MAX_LEVERAGE=2
OKX_API_BASE=https://eea.okx.com
OKX_CLI_TIMEOUT_MS=10000
ENGINE_BIND=127.0.0.1
ENGINE_PORT=8080
LOG_LEVEL=info

# Docker host override (used only by Compose):
LM_STUDIO_HOST_ORIGIN=http://host.docker.internal:1234
DASHBOARD_PORT=8088
# A new filename starts a new run; preserve old files when changing starting capital.
DOCKER_DB_PATH=/data/catfolio-paper.sqlite

# Demo/live plumbing retained; keep DRY_RUN=true for this experiment.
# MODE=demo additionally requires DRY_RUN=false and TWO distinct demo sub-accounts:
# TIGER_OKX_DEMO_API_KEY=...
# TIGER_OKX_DEMO_API_SECRET=...
# TIGER_OKX_DEMO_API_PASSPHRASE=...
# MOCHI_OKX_DEMO_API_KEY=...
# MOCHI_OKX_DEMO_API_SECRET=...
# MOCHI_OKX_DEMO_API_PASSPHRASE=...
# Live also requires the original exact LIVE_ACK phrase, plus TIGER_OKX_API_*
# and MOCHI_OKX_API_* credentials. No live credentials/ack are supplied here.
# LIVE_SIZE_MULTIPLIER=0.25
# LIVE_RAMP_HOURS=2

# Rules-and-coins trainer runs at most once per cat per 20 hours, using the Vercel AI Gateway text model.
# Defaults to enabled when AI_GATEWAY_API_KEY is present; false disables new reviews.
# COACH_ENABLED=true
COACH_MODEL=anthropic/claude-sonnet-4.6
# Separate owner-only approval key (at least 24 characters). Never use your Vercel key.
# Generate with: openssl rand -hex 32
# Click "you a trainer?" in the dashboard and enter this key; it is remembered in this browser tab across refreshes.
COACH_ADMIN_TOKEN=
